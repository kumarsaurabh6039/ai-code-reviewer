# Copy this file to .env and fill in values
DATABASE_URL=sqlite:///./app.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/codereviewer
SECRET_KEY=change-this-to-a-long-random-string
# Get a key from https://console.anthropic.com  (optional: without it only static analysis runs)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
CORS_ORIGINS=http://localhost:4200
